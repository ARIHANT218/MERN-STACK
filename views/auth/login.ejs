<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">LOGIN PAGE</h1>

        <p class="text-center text-gray-600 mb-4">Please enter your credentials to login.</p>
        
        <form action="/login" method="POST" class="max-w-md mx-auto">
          <div class="gap-3 mb-4" >
            <%- include('../partials/errors') %>
          </div>

            <input type="text" name="email" placeholder="Enter your email" 
            value="<%= typeof oldInput !== 'undefined' ? oldInput.email : '' %>"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>

            <input type="password" name="password" placeholder="Enter your password" class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>

            <input type="submit" value="Login" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
     
    </main>
  </body>
</html>